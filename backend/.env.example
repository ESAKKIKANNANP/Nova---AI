# =============================================================================
# .env.example
#
# Environment variable template for the FastAPI backend.
# Usage:
#   cp .env.example .env
#   # Edit .env with real values — NEVER commit .env to version control
#
# All variables are read by `app/config.py` via pydantic-settings.
# Defaults listed here are development-safe; override in production.
# =============================================================================

# ----------------------------------------------------------------------------
# Application identity
# ----------------------------------------------------------------------------

# Human-readable name surfaced in OpenAPI docs and structured log records.
APP_NAME="Autonomous Data Scientist API"

# Semantic version string (shown in /health and OpenAPI docs).
APP_VERSION="0.1.0"

# Deployment environment. Controls log format and debug behaviour.
# Allowed values: development | staging | production
ENV=development

# Enable FastAPI debug mode (auto-reloader, detailed tracebacks).
# Set to false in production.
DEBUG=true

# ----------------------------------------------------------------------------
# Server binding
# ----------------------------------------------------------------------------

# Interface the ASGI server listens on for local development.
HOST=127.0.0.1

# TCP port exposed by uvicorn / gunicorn.
PORT=8000

# Number of gunicorn worker processes (production only).
# Rule of thumb: (2 × CPU cores) + 1
WORKERS=1

# ----------------------------------------------------------------------------
# API routing
# ----------------------------------------------------------------------------

# URL prefix for all versioned routes (e.g. /api/v1/users).
API_V1_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

# Minimum log level emitted.
# Allowed values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Log output format.
# Allowed values: json (production) | console (human-readable dev)
LOG_FORMAT=console

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------

# Comma-separated list of allowed origins.
# Use ["*"] in development only.  In production, list exact origins.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Whether to allow credentials (cookies / Authorization headers) cross-origin.
ALLOW_CREDENTIALS=true

# Comma-separated list of allowed HTTP methods.
ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]

# Comma-separated list of allowed request headers.
ALLOWED_HEADERS=["*"]

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------

# Secret key used for signing tokens or cookies (generate with `openssl rand -hex 32`).
# MUST be overridden in production.
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# Token expiry in minutes (used when auth is implemented).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./dev.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./dev.db
