# =============================================================================
# .dockerignore
#
# Files and directories excluded from the Docker build context.
# Keeping the context small speeds up `docker build` and prevents secrets
# (e.g. .env) or dev artefacts from leaking into the production image.
# =============================================================================

# Virtual environments managed by uv / venv
.venv
__pypackages__

# Python bytecode caches
__pycache__
*.py[cod]
*.pyo

# Test & coverage artefacts
.pytest_cache
htmlcov
.coverage
coverage.xml

# Editor & OS artefacts
.DS_Store
.idea
.vscode
*.swp
*.swo
Thumbs.db

# Secrets — never bake these into the image
.env
*.env

# CI/CD configs (not needed at runtime)
.github
.gitlab-ci.yml

# Documentation
docs
*.md

# Git metadata
.git
.gitignore

# mypy cache
.mypy_cache

# ruff cache
.ruff_cache
